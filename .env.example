# Career Mate configuration. `uv run python -m src.cli init` copies this file to .env.
# Fill in the keys for the providers you use; never commit .env (it is git-ignored).
# Which model serves which task is set in config/models.toml.

# --- Model providers (only the ones config/models.toml uses are required) ---

# Hugging Face router: default chat/extraction models (openai/gpt-oss-120b on Groq).
# Fine-grained token with "Make calls to Inference Providers": https://huggingface.co/settings/tokens
# To use it for free, save your Groq key as a custom provider key: https://huggingface.co/settings/inference-providers
HF_TOKEN=

# Gemini: embeddings for CV search (role "embed"). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional providers, if you point a role at them in config/models.toml
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Try another model without editing config/models.toml (examples)
# LLM_DEFAULT_MODEL=openai/gpt-oss-20b:groq
# LLM_EXTRACT_PROVIDER=gemini
# LLM_EXTRACT_MODEL=gemini-3.5-flash

# --- Database (PostgreSQL + pgvector) ---

# Local: `docker compose up -d db` starts one matching this URL.
# Supabase: Project > Connect > "Session pooler" URI (IPv4, keeps SET search_path), with your DB password.
DATABASE_URL=postgresql://career:career@localhost:5432/career
# Private schema for the app's tables (not exposed by Supabase's auto-generated REST API)
DB_SCHEMA=career

# --- Login (Supabase Auth) ---

# Empty = no login: every request is one local dev user (refused when APP_ENV=production).
# Supabase: Project Settings > API > Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Only for projects still using the legacy shared JWT secret (HS256). New projects use signing keys (JWKS): leave empty.
SUPABASE_JWT_SECRET=

# --- Server ---

# development | production
APP_ENV=development
# Web UI origins allowed to call the API, comma-separated (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173
