# Career Mate configuration. `uv run python -m src.cli init` copies this file to .env.
# Fill in the keys for the providers you use; never commit .env (it is git-ignored).
# Which model serves which task is set in config/models.toml, not here.

# --- Model providers (only the ones config/models.toml uses are required) ---

# Hugging Face router: default chat/extraction models (openai/gpt-oss-120b on Groq).
# Fine-grained token with "Make calls to Inference Providers": https://huggingface.co/settings/tokens
# To use it for free, save your Groq key as a custom provider key: https://huggingface.co/settings/inference-providers
HF_TOKEN=

# Gemini: embeddings for CV search (role "embed"). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional providers, if you point a role at them in config/models.toml
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Try another model without editing config/models.toml (examples)
# LLM_DEFAULT_MODEL=openai/gpt-oss-20b:groq
# LLM_EXTRACT_PROVIDER=gemini
# LLM_EXTRACT_MODEL=gemini-3.5-flash

# --- Your data ---

# Folder for your database (career_mate.db), CVs and profile. Relative to the repo, or an absolute path
# (e.g. a folder you back up). Keep it private: it holds your CV, offers and contacts.
DATA_DIR=data

# --- Optional ---

# Legacy web-search pipeline only (Google Custom Search)
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=

# LOG_LEVEL=INFO
# HTTP_TIMEOUT_S=20
